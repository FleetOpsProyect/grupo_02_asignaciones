# Copia este archivo a .env y ajusta los valores. El .env real no se sube al repo.

# Puerto en el que escucha el servicio
APP_PORT=8000

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Por defecto apunta al contenedor "postgres" de docker-compose.yml (perfil
# "local-db"), usando el nombre del servicio como host: asi funciona cuando
# el propio microservicio corre dentro de docker-compose. Si lo ejecutas
# fuera de Docker (uv run flask/gunicorn) cambia "postgres" por "localhost",
# ya que docker-compose publica el puerto 5432 tambien en el host. Para usar
# una base de datos externa, reemplaza el valor completo por el que te
# entreguen, por ejemplo:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host-externo:5432/asignaciones
DATABASE_URL=postgresql+psycopg://assignments:assignments@postgres:5432/assignments

# Por defecto apunta al contenedor "redis" de docker-compose.yml, igual que
# DATABASE_URL (usa "localhost" en vez de "redis" si corres el servicio
# fuera de Docker). Redis es opcional: si se deja vacio, el servicio arranca
# igual y /ready no lo incluye entre sus dependencias. Para usar un Redis
# externo, reemplaza el valor por el que te entreguen, por ejemplo:
# REDIS_URL=redis://host-externo:6379/0
REDIS_URL=redis://redis:6379/0
